# mock : fichiers JSON ; odds-api : 1xBet et Pinnacle via The Odds API, Bet261 via son site public.
DATA_SOURCE=mock
MOCK_DATA_DIR=./data/examples
# Pour les données réelles, utiliser ./data/odds-live.sqlite pour séparer l'historique.
DATABASE_PATH=./data/odds.sqlite

# percentage : (max - min) / min * 100 ; absolute : max - min.
# Le seuil doit être strictement dépassé.
ODDS_THRESHOLD_MODE=percentage
ODDS_THRESHOLD=10

INTERVAL_MINUTES=10
MATCH_TOLERANCE_MINUTES=15
COLLECTOR_TIMEOUT_MS=15000

# Interface web locale : npm run web, puis http://127.0.0.1:3000
WEB_PORT=3000

ODDS_API_KEY=
# Football uniquement ; deux requêtes par compétition et par collecte (1xBet et Pinnacle).
ODDS_API_SPORTS=soccer_epl

# Scraping du flux JSON public affiché par Bet261, pour les mêmes compétitions.
BET261_ENABLED=true
